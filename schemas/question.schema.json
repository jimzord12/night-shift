{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jimzord12/night-shift/schemas/question.schema.json",
  "title": "Night Shift question",
  "description": ".night-shift/questions/<id>.json. The asker writes every field except answer; the app writes only answer.",
  "type": "object",
  "required": ["schema", "id", "shift", "question", "kind", "recommended", "because", "answer", "resolved"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "question/1" },
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-(night|day)-\\d{2,3}$", "description": "<shift>-<nn>, equal to the file name without .json." },
    "shift": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-(night|day)$" },
    "card": { "type": "string", "description": "Task id of the card this blocks or belongs to, if any." },
    "blocking": { "type": "boolean", "default": false },
    "topic": { "type": "string", "description": "Short group name; the app groups questions by it." },
    "question": { "type": "string", "minLength": 1 },
    "why": { "type": "string", "description": "One line of context." },
    "kind": { "enum": ["confirm", "one", "many", "rank", "text"] },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "image": { "type": "string", "description": "Path relative to .night-shift/, usually assets/..." }
        }
      }
    },
    "min": { "type": "integer", "minimum": 0, "description": "many: fewest picks. Default 1." },
    "max": { "type": "integer", "minimum": 1, "description": "many: most picks. Default all." },
    "recommended": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Option ids (confirm: yes or no; rank: the full recommended order; text: one suggested answer)."
    },
    "because": { "type": "string", "minLength": 1, "description": "Why the asker recommends it, one line." },
    "images": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Extra pictures shown with the question, paths relative to .night-shift/."
    },
    "answer": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["at", "status", "value"],
          "additionalProperties": false,
          "properties": {
            "at": { "type": "string", "format": "date-time" },
            "status": { "enum": ["answered", "deferred"] },
            "value": { "type": "array", "items": { "type": "string" }, "description": "Option ids, the order for rank, one string for text; empty when deferred." },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "resolved": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["at", "into"],
          "additionalProperties": false,
          "properties": {
            "at": { "type": "string", "format": "date-time" },
            "into": { "type": "string", "minLength": 1, "description": "What the answer became: a card URL, a commit, a sentence." }
          }
        }
      ]
    }
  }
}
