{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jimzord12/night-shift/schemas/plan.schema.json",
  "title": "Night Shift plan: the agent's promise at the start of a night",
  "type": "object",
  "required": ["schema", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema": { "enum": ["night-shift/plan@1", "night-shift/plan@2", "night-shift/plan@3"] },
    "night": { "type": "string", "description": "Added by the tool" },
    "started_at": { "type": "string", "description": "Added by the tool" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "source", "done_when"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "source": { "type": "string", "minLength": 1, "maxLength": 300 },
          "done_when": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "follow_up": { "oneOf": [{ "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z]+/A[0-9]+$" }, { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z]+/A[0-9]+$" } }] }
        }
      }
    },
    "start_checks": {
      "description": "Version 3: the commands the agent ran before planning, to prove the night can work (tests, a commit, its services); the tool refuses to start while one failed",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "excerpt"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 300 },
          "exit_code": { "type": "integer" },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "proves": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "skipped_follow_ups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["follow_up", "reason"],
        "additionalProperties": false,
        "properties": {
          "follow_up": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z]+/A[0-9]+$" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}
