{
  "name": "night-shift",
  "private": true,
  "description": "The Night Shift Protocol: prepare work by day, let agents build it at night, review it in the morning. Protocol text, JSON contract and a local app for the morning review.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "night-shift": "./src/cli.ts"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "serve": "node src/cli.ts serve",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test \"tests/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "ajv": "8.20.0",
    "hono": "4.13.9",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "canvas-confetti": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
